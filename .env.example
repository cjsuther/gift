APP_ENV=local
APP_URL=http://localhost:8000
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=giftcards
DB_USER=root
DB_PASSWORD=

JWT_SECRET=cambiar-por-string-aleatorio-largo-min-32-chars
