APP_ENV=local
APP_URL=http://localhost:8000
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=giftcards
DB_USER=root
DB_PASSWORD=

JWT_SECRET=cambiar-por-string-aleatorio-largo-min-32-chars
JWT_TTL_HOURS=2

UPLOAD_MAX_MB=2
UPLOAD_PATH=public/uploads

# Super admin inicial (seeder)
SUPERADMIN_EMAIL=admin@app.com
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_PASSWORD=cambiar-en-primer-login

# SMTP para notificaciones (ej. cuando se canjea una giftcard avisa al sender).
# Si MAIL_HOST está vacío, los emails se omiten silenciosamente.
# Hostinger: smtp.hostinger.com puerto 465 con SSL (crear cuenta en hPanel primero).
MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@app.com
MAIL_FROM_NAME="Giftcards"
