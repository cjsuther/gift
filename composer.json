{
  "name": "rusvel/giftcards",
  "description": "Sistema multi-tenant de gestión de giftcards con QR",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "slim/slim": "^4.0",
    "slim/psr7": "^1.6",
    "firebase/php-jwt": "^6.10",
    "endroid/qr-code": "^5.0",
    "intervention/image": "^3.5",
    "vlucas/phpdotenv": "^5.6",
    "phpmailer/phpmailer": "^6.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "audit": {
      "ignore": {
        "PKSA-y2cr-5h3j-g3ys": "Advisory afecta a todas las versiones disponibles de firebase/php-jwt ^6.10. Revisar antes de pasar a producción y migrar si hay parche."
      }
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "migrate": "php migrations/run.php",
    "seed": "php migrations/seed.php"
  }
}
